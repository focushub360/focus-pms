# ==============================================================================
# Focus PMS Backend - Environment Variables Template
# Copy this file to .env and configure the values for your deployment
# ==============================================================================

# Database Connection (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=focus_pms
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Authentication & Security
# Generate a strong 64-character secret in terminal: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_ALG=HS256
JWT_TTL_HOURS=12

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g., https://focus-pms.netlify.app,http://localhost:3000)
# Use * during initial setup, then restrict to your production frontend URL
CORS_ORIGINS=*

# Public URL of the frontend application (used in activation & password reset emails)
# Example: https://focus-pms.netlify.app
APP_PUBLIC_URL=http://localhost:3000

# Bootstrap Initial Super Administrator Account
BOOTSTRAP_ADMIN_EMAIL=kiran@focusengineering.in
BOOTSTRAP_ADMIN_PASSWORD=Kiran@123
BOOTSTRAP_ADMIN_NAME=Kiran Kulkarni

# Email Configuration (Resend.com)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM_NAME=Focus Engineering PMS
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_REPLY_TO=

# Optional: Internal Webhook Secret for scheduled cron triggers
WEBHOOK_CRON_SECRET=

